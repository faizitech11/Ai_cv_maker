generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cvs CV[]
}

model CV {
  id        String   @id @default(cuid())
  title     String   @default("My CV")
  template  String   @default("modern")
  status    String   @default("draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  personalInfo   PersonalInfo?
  education      Education[]
  experiences    Experience[]
  skills         Skill[]
  projects       Project[]
  certifications Certification[]
  languages      Language[]
  uploadedCVs    UploadedCV[]
  aiContents     AIContent[]

  @@index([userId])
}

model PersonalInfo {
  id           String  @id @default(cuid())
  fullName     String?
  email        String?
  phone        String?
  address      String?
  city         String?
  country      String?
  summary      String?
  jobTitle     String?
  profileImage String?
  linkedin     String?
  github       String?
  portfolio    String?

  cvId String @unique
  cv   CV     @relation(fields: [cvId], references: [id], onDelete: Cascade)
}

model Education {
  id          String  @id @default(cuid())
  degree      String
  institution String
  location    String?
  startDate   String?
  endDate     String?
  description String?

  cvId String
  cv   CV     @relation(fields: [cvId], references: [id], onDelete: Cascade)

  @@index([cvId])
}

model Experience {
  id          String  @id @default(cuid())
  position    String
  company     String
  location    String?
  startDate   String?
  endDate     String?
  description String?

  cvId String
  cv   CV     @relation(fields: [cvId], references: [id], onDelete: Cascade)

  @@index([cvId])
}

model Skill {
  id    String  @id @default(cuid())
  name  String
  level String?

  cvId String
  cv   CV     @relation(fields: [cvId], references: [id], onDelete: Cascade)

  @@index([cvId])
}

model Project {
  id           String  @id @default(cuid())
  name         String
  description  String?
  technologies String?
  projectUrl   String?
  startDate    String?
  endDate      String?

  cvId String
  cv   CV     @relation(fields: [cvId], references: [id], onDelete: Cascade)

  @@index([cvId])
}

model Certification {
  id            String  @id @default(cuid())
  name          String
  organization  String?
  issueDate     String?
  expiryDate    String?
  credentialId  String?
  credentialUrl String?

  cvId String
  cv   CV     @relation(fields: [cvId], references: [id], onDelete: Cascade)

  @@index([cvId])
}

model Language {
  id          String  @id @default(cuid())
  name        String
  proficiency String?

  cvId String
  cv   CV     @relation(fields: [cvId], references: [id], onDelete: Cascade)

  @@index([cvId])
}

model UploadedCV {
  id            String   @id @default(cuid())
  originalName  String
  fileName      String
  fileType      String
  fileSize      Int
  filePath      String?
  extractedText String?  @db.LongText
  parsedData    Json?
  status        String   @default("uploaded")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cvId String
  cv   CV     @relation(fields: [cvId], references: [id], onDelete: Cascade)

  @@index([cvId])
}

model AIContent {
  id            String   @id @default(cuid())
  type          String
  originalText  String?  @db.Text
  generatedText String?  @db.Text
  model         String?
  status        String   @default("generated")
  createdAt     DateTime @default(now())

  cvId String
  cv   CV     @relation(fields: [cvId], references: [id], onDelete: Cascade)

  @@index([cvId])
}
